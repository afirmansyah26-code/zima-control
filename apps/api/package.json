{
  "name": "@zima-control-center/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/start.js",
    "auth:bootstrap": "node dist/bootstrap.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/application.test.ts src/runtime.test.ts src/auth.test.ts src/auth-prisma.test.ts src/mutation.test.ts src/mutation-status-service.test.ts src/mutation-status-http.test.ts src/provision.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@prisma/client": "^6.19.0",
    "@zima-control-center/application-registry-contracts": "0.1.0",
    "@zima-control-center/core": "0.1.0",
    "hono": "^4.13.5"
  }
}
