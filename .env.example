# ==============================================================================
# Zima Control Center — Environment Configuration Example
# ==============================================================================

# Web UI exposed host port
WEB_PORT=8080

# Internal API port
API_PORT=3000
API_HOST=0.0.0.0

# Database URL for persistent SQLite registry
DATABASE_URL=file:/data/registry.db

# Mutation capability mode:
# - DISABLED: No runtime mutations
# - STATUS_ONLY: Read-only status
# - RUNTIME_ADAPTER: Uses privileged AF_UNIX runtime adapter daemon (Default)
MUTATION_CAPABILITY_MODE=RUNTIME_ADAPTER

# AF_UNIX socket path for privileged runtime adapter
APPLICATION_RUNTIME_SOCKET_PATH=/run/zcc/application-runtime.sock
RUNTIME_SOCKET_PATH=/run/zcc/application-runtime.sock

# ZimaOS endpoint for discovery
ZIMAOS_BASE_URL=http://192.168.56.101

# Worker observation polling interval in milliseconds (default: 30000)
OBSERVATION_INTERVAL_MS=30000

# Proxy / TLS header trust
TRUST_FORWARDED_PROTO=true

# Secure Cookie flag:
# - false: For direct HTTP deployments / LAN access (Default in compose.yaml)
# - true: Set when terminating HTTPS / TLS via external reverse proxy
AUTH_COOKIE_SECURE=false
