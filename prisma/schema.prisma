datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Application {
  id               String    @id @default(uuid())
  name             String    @unique
  displayName      String?
  resourceType     String?
  runtime          String?
  status           String?
  managedBy        String?
  zimaosAppId      String?   @unique
  zimaosStoreAppId String?
  isUncontrolled   Boolean?
  lastDiscoveredAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deployment            ApplicationDeployment?
  authorityAssociations AuthorityApplication[]

  @@index([status])
}

model ApplicationDeployment {
  id                  String   @id @default(uuid())
  applicationId       String   @unique
  composeName         String
  composeYamlRedacted String
  sourceContext       String?
  dockerfilePath      String?
  sourceHash          String?
  discoveredAt        DateTime

  application Application          @relation(fields: [applicationId], references: [id], onUpdate: Restrict)
  services    ApplicationService[]
}

model ApplicationService {
  id            String  @id @default(uuid())
  deploymentId  String
  name          String
  containerName String?
  image         String?
  buildContext  String?

  deployment           ApplicationDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  ports                DeploymentPort[]
  volumes              DeploymentVolume[]
  networks             DeploymentNetwork[]
  environmentVariables EnvironmentVariable[]
  runtimeContainers    RuntimeContainer[]

  @@unique([deploymentId, name])
}

model DeploymentPort {
  id        String @id @default(uuid())
  serviceId String
  published String
  target    Int
  protocol  String

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model DeploymentVolume {
  id        String @id @default(uuid())
  serviceId String
  source    String
  target    String

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model DeploymentNetwork {
  id         String   @id @default(uuid())
  serviceId  String
  name       String
  isExternal Boolean?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId, name])
}

model EnvironmentVariable {
  id         String   @id @default(uuid())
  serviceId  String
  key        String
  type       String?
  isSecret   Boolean
  configured Boolean?
  present    Boolean?
  source     String?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([serviceId, key])
}

model RuntimeContainer {
  id            String    @id @default(uuid())
  serviceId     String
  containerId   String    @unique
  containerName String?
  image         String?
  state         String?
  status        String?
  observedAt    DateTime?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model MutationOperation {
  id                String    @id @default(uuid())
  actorId           String
  actorRole         String
  action            String
  applicationId     String
  serviceId         String?
  containerId       String?
  executionDomain   String
  operationKey      String
  fingerprint       String
  status            String
  verificationState String    @default("NOT_STARTED")
  recoveryState     String    @default("NONE")
  externalEffect    String    @default("NOT_STARTED")
  fencingToken      Int?
  reasonCode        String?
  deadlineAt        DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  auditSequence     Int       @default(0)

  idempotencyClaim MutationIdempotencyClaim?
  auditEvents      MutationAuditEvent[]
  steps            MutationOperationStep[]
  ownedLock        MutationLock?

  @@index([status, deadlineAt])
  @@index([operationKey, status])
  @@index([applicationId, createdAt])
}

model MutationOperationStep {
  id                      String    @id @default(uuid())
  parentOperationId       String
  sequence                Int
  applicationId           String
  deploymentId            String
  serviceId               String
  containerId             String
  action                  String
  executionDomain         String
  targetFingerprint       String
  snapshotAt              DateTime
  authorityEvidence       String
  applicationDiscoveredAt DateTime
  deploymentDiscoveredAt  DateTime
  runtimeObservedAt       DateTime
  deadlineAt              DateTime
  status                  String    @default("VALIDATED")
  verificationState       String    @default("NOT_STARTED")
  recoveryState           String    @default("NONE")
  externalEffect          String    @default("NOT_STARTED")
  fencingToken            Int?
  dispatchFencingToken    Int?
  dispatchAuthorizedAt    DateTime?
  reasonCode              String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  parentOperation MutationOperation    @relation(fields: [parentOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents     MutationAuditEvent[]

  @@unique([parentOperationId, sequence])
  @@unique([parentOperationId, containerId])
  @@index([parentOperationId, status])
  @@index([status, deadlineAt])
  @@index([containerId, status])
}

model MutationIdempotencyClaim {
  id             String   @id @default(uuid())
  actorId        String
  idempotencyKey String
  fingerprint    String
  operationId    String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  operation MutationOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorId, idempotencyKey])
  @@index([expiresAt])
}

model MutationLock {
  operationKey     String    @id
  ownerOperationId String?   @unique
  fencingToken     Int       @default(0)
  acquiredAt       DateTime?
  leaseExpiresAt   DateTime?
  updatedAt        DateTime  @updatedAt

  ownerOperation MutationOperation? @relation(fields: [ownerOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerOperationId])
  @@index([leaseExpiresAt])
}

model MutationAuditEvent {
  id            String   @id @default(uuid())
  operationId   String
  childStepId   String?
  sequence      Int
  actorId       String
  actorRole     String
  action        String
  applicationId String
  serviceId     String?
  containerId   String?
  status        String
  eventType     String
  reasonCode    String?
  timestamp     DateTime

  operation MutationOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childStep MutationOperationStep? @relation(fields: [childStepId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, sequence])
  @@index([childStepId])
  @@index([timestamp])
}

model Authority {
  id              String   @id @default(uuid())
  installationKey String   @unique @default("PRIMARY")
  auditSequence   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications AuthorityApplication[]
  auditEvents  AuthorityAuditEvent[]
  issuer       AuthorityIssuer?
}

model AuthorityIssuer {
  issuerId           String    @id
  authorityId        String    @unique
  serviceBoundaryId  String    @unique
  trustStatus        String
  stateVersion       Int       @default(0)
  trustAuditSequence Int       @default(0)
  activeKeyId        String?   @unique
  pendingKeyId       String?   @unique
  currentOperationId String?   @unique
  bindingEpoch       String    @unique
  createdAt          DateTime  @default(now())
  stateChangedAt     DateTime  @default(now())
  boundAt            DateTime?
  activatedAt        DateTime?
  lastValidatedAt    DateTime?
  revokedAt          DateTime?
  rebindRequiredAt   DateTime?
  failedAt           DateTime?
  uncertainAt        DateTime?
  updatedAt          DateTime  @updatedAt

  authority        Authority                  @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keys             AuthoritySigningKey[]      @relation("IssuerSigningKeys")
  activeKey        AuthoritySigningKey?       @relation("ActiveIssuerKey", fields: [issuerId, activeKeyId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  pendingKey       AuthoritySigningKey?       @relation("PendingIssuerKey", fields: [issuerId, pendingKeyId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  currentOperation AuthorityTrustOperation?   @relation("CurrentTrustOperation", fields: [issuerId, currentOperationId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  intents          AuthorityIntent[]
  operations       AuthorityTrustOperation[]  @relation("IssuerTrustOperations")
  trustAuditEvents AuthorityTrustAuditEvent[]

  @@unique([authorityId, issuerId])
  @@unique([issuerId, activeKeyId])
  @@unique([issuerId, pendingKeyId])
  @@unique([issuerId, currentOperationId])
  @@index([trustStatus])
}

model AuthoritySigningKey {
  id                   String    @id @default(uuid())
  issuerId             String
  keyVersion           Int
  publicKey            String
  publicKeyEncoding    String
  publicKeyFingerprint String    @unique
  fingerprintAlgorithm String
  algorithm            String
  status               String
  predecessorKeyId     String?   @unique
  createdAt            DateTime  @default(now())
  boundAt              DateTime?
  validatedAt          DateTime?
  activatedAt          DateTime?
  revokedAt            DateTime?
  failedAt             DateTime?
  updatedAt            DateTime  @updatedAt

  issuer              AuthorityIssuer            @relation("IssuerSigningKeys", fields: [issuerId], references: [issuerId], onDelete: Restrict, onUpdate: Restrict)
  predecessor         AuthoritySigningKey?       @relation("SigningKeyPredecessor", fields: [issuerId, predecessorKeyId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  successor           AuthoritySigningKey?       @relation("SigningKeyPredecessor")
  activeForIssuer     AuthorityIssuer?           @relation("ActiveIssuerKey")
  pendingForIssuer    AuthorityIssuer?           @relation("PendingIssuerKey")
  candidateOperations AuthorityTrustOperation[]  @relation("TrustOperationCandidateKey")
  trustAuditEvents    AuthorityTrustAuditEvent[]

  @@unique([issuerId, keyVersion])
  @@unique([issuerId, id])
  @@unique([issuerId, predecessorKeyId])
  @@index([issuerId, status])
}

model AuthorityTrustOperation {
  id                   String    @id @default(uuid())
  authorityId          String
  issuerId             String
  operationType        String
  status               String
  idempotencyKey       String
  requestFingerprint   String
  correlationId        String
  actorType            String
  actorId              String
  expectedStateVersion Int
  candidateKeyId       String?
  reasonCode           String?
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  issuer           AuthorityIssuer            @relation("IssuerTrustOperations", fields: [authorityId, issuerId], references: [authorityId, issuerId], onDelete: Restrict, onUpdate: Restrict)
  candidateKey     AuthoritySigningKey?       @relation("TrustOperationCandidateKey", fields: [issuerId, candidateKeyId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  currentForIssuer AuthorityIssuer?           @relation("CurrentTrustOperation")
  auditEvents      AuthorityTrustAuditEvent[]

  @@unique([issuerId, id])
  @@unique([issuerId, idempotencyKey])
  @@unique([authorityId, correlationId])
  @@index([issuerId, status])
}

model AuthorityTrustAuditEvent {
  id                   String   @id @default(uuid())
  authorityId          String
  issuerId             String
  sequence             Int
  operationId          String?
  keyId                String?
  keyVersion           Int?
  publicKeyFingerprint String?
  eventType            String
  previousState        String?
  newState             String?
  actorType            String?
  actorId              String?
  correlationId        String?
  reasonCode           String?
  timestamp            DateTime

  issuer    AuthorityIssuer          @relation(fields: [authorityId, issuerId], references: [authorityId, issuerId], onDelete: Restrict, onUpdate: Restrict)
  operation AuthorityTrustOperation? @relation(fields: [issuerId, operationId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)
  key       AuthoritySigningKey?     @relation(fields: [issuerId, keyId], references: [issuerId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([issuerId, sequence])
  @@index([operationId])
  @@index([keyId])
  @@index([timestamp])
}

model AuthorityApplication {
  authorityId        String
  applicationId      String
  zimaosAppId        String?
  pendingIntentId    String?  @unique
  activeGenerationId String?  @unique
  stateVersion       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authority        Authority             @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application      Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pendingIntent    AuthorityIntent?      @relation("PendingAuthorityIntent", fields: [pendingIntentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeGeneration AuthorityDeployment?  @relation("ActiveAuthorityDeployment", fields: [activeGenerationId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  intents          AuthorityIntent[]
  deployments      AuthorityDeployment[]

  @@id([authorityId, applicationId])
  @@index([applicationId])
  @@index([authorityId, activeGenerationId])
  @@index([authorityId, pendingIntentId])
}

model AuthorityIntent {
  id                  String    @id @default(uuid())
  authorityId         String
  issuerId            String
  applicationId       String
  idempotencyKey      String
  fingerprint         String
  intentType          String
  status              String
  sourceReference     String
  sourceHash          String
  requestedServiceSet String
  reasonCode          String?
  createdAt           DateTime  @default(now())
  acceptedAt          DateTime?
  authorizedAt        DateTime?
  invalidatedAt       DateTime?
  updatedAt           DateTime  @updatedAt

  issuerBinding         AuthorityIssuer       @relation(fields: [authorityId, issuerId], references: [authorityId, issuerId], onDelete: Restrict, onUpdate: Restrict)
  authorityApplication  AuthorityApplication  @relation(fields: [authorityId, applicationId], references: [authorityId, applicationId], onDelete: Restrict, onUpdate: Restrict)
  deployment            AuthorityDeployment?
  pendingForApplication AuthorityApplication? @relation("PendingAuthorityIntent")
  auditEvents           AuthorityAuditEvent[]

  @@unique([issuerId, idempotencyKey])
  @@index([authorityId, applicationId, status])
  @@index([authorityId, status])
}

model AuthorityDeployment {
  generationId  String    @id @default(uuid())
  authorityId   String
  applicationId String
  intentId      String    @unique
  status        String
  reasonCode    String?
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  authorizedAt  DateTime?
  invalidatedAt DateTime?
  updatedAt     DateTime  @updatedAt

  authorityApplication AuthorityApplication  @relation(fields: [authorityId, applicationId], references: [authorityId, applicationId], onDelete: Restrict, onUpdate: Restrict)
  intent               AuthorityIntent       @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services             AuthorityService[]
  activeForApplication AuthorityApplication? @relation("ActiveAuthorityDeployment")
  auditEvents          AuthorityAuditEvent[]

  @@index([authorityId, applicationId, status])
  @@index([status, updatedAt])
}

model AuthorityService {
  serviceIdentity        String   @id @default(uuid())
  deploymentId           String
  sourceServiceReference String
  serviceName            String
  createdAt              DateTime @default(now())

  deployment  AuthorityDeployment   @relation(fields: [deploymentId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  auditEvents AuthorityAuditEvent[]

  @@unique([deploymentId, serviceIdentity])
  @@unique([deploymentId, sourceServiceReference])
  @@index([deploymentId])
}

model AuthorityAuditEvent {
  id              String   @id @default(uuid())
  authorityId     String
  sequence        Int
  issuerId        String
  applicationId   String?
  deploymentId    String?
  intentId        String?
  serviceIdentity String?
  eventType       String
  status          String?
  reasonCode      String?
  timestamp       DateTime

  authority  Authority            @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployment AuthorityDeployment? @relation(fields: [deploymentId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  intent     AuthorityIntent?     @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  service    AuthorityService?    @relation(fields: [serviceIdentity], references: [serviceIdentity], onDelete: Restrict, onUpdate: Restrict)

  @@unique([authorityId, sequence])
  @@index([intentId])
  @@index([deploymentId])
  @@index([serviceIdentity])
  @@index([timestamp])
}
