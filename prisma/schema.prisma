datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Application {
  id               String    @id @default(uuid())
  name             String    @unique
  displayName      String?
  resourceType     String?
  runtime          String?
  status           String?
  managedBy        String?
  zimaosAppId      String?   @unique
  zimaosStoreAppId String?
  isUncontrolled   Boolean?
  lastDiscoveredAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deployment            ApplicationDeployment?
  authorityAssociations AuthorityApplication[]
  backupConfig          BackupConfig?

  @@index([status])
}

model ApplicationDeployment {
  id                  String   @id @default(uuid())
  applicationId       String   @unique
  composeName         String
  composeYamlRedacted String
  sourceContext       String?
  dockerfilePath      String?
  sourceHash          String?
  discoveredAt        DateTime

  application Application          @relation(fields: [applicationId], references: [id], onUpdate: Restrict)
  services    ApplicationService[]
}

model ApplicationService {
  id            String  @id @default(uuid())
  deploymentId  String
  name          String
  containerName String?
  image         String?
  buildContext  String?

  deployment           ApplicationDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  ports                DeploymentPort[]
  volumes              DeploymentVolume[]
  networks             DeploymentNetwork[]
  environmentVariables EnvironmentVariable[]
  runtimeContainers    RuntimeContainer[]

  @@unique([deploymentId, name])
}

model DeploymentPort {
  id        String @id @default(uuid())
  serviceId String
  published String
  target    Int
  protocol  String

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model DeploymentVolume {
  id        String @id @default(uuid())
  serviceId String
  source    String
  target    String

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model DeploymentNetwork {
  id         String   @id @default(uuid())
  serviceId  String
  name       String
  isExternal Boolean?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId, name])
}

model EnvironmentVariable {
  id         String   @id @default(uuid())
  serviceId  String
  key        String
  type       String?
  isSecret   Boolean
  configured Boolean?
  present    Boolean?
  source     String?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([serviceId, key])
}

model RuntimeContainer {
  id            String    @id @default(uuid())
  serviceId     String
  containerId   String    @unique
  containerName String?
  image         String?
  state         String?
  status        String?
  observedAt    DateTime?

  service ApplicationService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([serviceId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model MutationOperation {
  id                String    @id @default(uuid())
  actorId           String
  actorRole         String
  action            String
  applicationId     String
  serviceId         String?
  containerId       String?
  executionDomain   String
  operationKey      String
  fingerprint       String
  status            String
  verificationState String    @default("NOT_STARTED")
  recoveryState     String    @default("NONE")
  externalEffect    String    @default("NOT_STARTED")
  fencingToken      Int?
  reasonCode        String?
  deadlineAt        DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  auditSequence     Int       @default(0)

  idempotencyClaim MutationIdempotencyClaim?
  auditEvents      MutationAuditEvent[]
  steps            MutationOperationStep[]
  ownedLock        MutationLock?

  @@index([status, deadlineAt])
  @@index([operationKey, status])
  @@index([applicationId, createdAt])
}

model MutationOperationStep {
  id                      String    @id @default(uuid())
  parentOperationId       String
  sequence                Int
  applicationId           String
  deploymentId            String
  serviceId               String
  containerId             String
  action                  String
  executionDomain         String
  targetFingerprint       String
  snapshotAt              DateTime
  authorityEvidence       String
  applicationDiscoveredAt DateTime
  deploymentDiscoveredAt  DateTime
  runtimeObservedAt       DateTime
  deadlineAt              DateTime
  status                  String    @default("VALIDATED")
  verificationState       String    @default("NOT_STARTED")
  recoveryState           String    @default("NONE")
  externalEffect          String    @default("NOT_STARTED")
  fencingToken            Int?
  dispatchFencingToken    Int?
  dispatchAuthorizedAt    DateTime?
  reasonCode              String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  parentOperation MutationOperation    @relation(fields: [parentOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents     MutationAuditEvent[]

  @@unique([parentOperationId, sequence])
  @@unique([parentOperationId, containerId])
  @@index([parentOperationId, status])
  @@index([status, deadlineAt])
  @@index([containerId, status])
}

model MutationIdempotencyClaim {
  id             String   @id @default(uuid())
  actorId        String
  idempotencyKey String
  fingerprint    String
  operationId    String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  operation MutationOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorId, idempotencyKey])
  @@index([expiresAt])
}

model MutationLock {
  operationKey     String    @id
  ownerOperationId String?   @unique
  fencingToken     Int       @default(0)
  acquiredAt       DateTime?
  leaseExpiresAt   DateTime?
  updatedAt        DateTime  @updatedAt

  ownerOperation MutationOperation? @relation(fields: [ownerOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerOperationId])
  @@index([leaseExpiresAt])
}

model MutationAuditEvent {
  id            String   @id @default(uuid())
  operationId   String
  childStepId   String?
  sequence      Int
  actorId       String
  actorRole     String
  action        String
  applicationId String
  serviceId     String?
  containerId   String?
  status        String
  eventType     String
  reasonCode    String?
  timestamp     DateTime

  operation MutationOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childStep MutationOperationStep? @relation(fields: [childStepId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, sequence])
  @@index([childStepId])
  @@index([timestamp])
}

model Authority {
  id              String   @id @default(uuid())
  installationKey String   @unique @default("PRIMARY")
  issuerId        String   @unique
  auditSequence   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications AuthorityApplication[]
  auditEvents  AuthorityAuditEvent[]
}

model AuthorityApplication {
  authorityId        String
  applicationId      String
  zimaosAppId        String?
  pendingIntentId    String?  @unique
  activeGenerationId String?  @unique
  stateVersion       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authority        Authority             @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application      Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pendingIntent    AuthorityIntent?      @relation("PendingAuthorityIntent", fields: [pendingIntentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeGeneration AuthorityDeployment?  @relation("ActiveAuthorityDeployment", fields: [activeGenerationId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  intents          AuthorityIntent[]
  deployments      AuthorityDeployment[]

  @@id([authorityId, applicationId])
  @@index([applicationId])
  @@index([authorityId, activeGenerationId])
  @@index([authorityId, pendingIntentId])
}

model AuthorityIntent {
  id                  String    @id @default(uuid())
  authorityId         String
  issuerId            String
  applicationId       String
  idempotencyKey      String
  fingerprint         String
  intentType          String
  status              String
  sourceReference     String
  sourceHash          String
  requestedServiceSet String
  reasonCode          String?
  createdAt           DateTime  @default(now())
  acceptedAt          DateTime?
  authorizedAt        DateTime?
  invalidatedAt       DateTime?
  updatedAt           DateTime  @updatedAt

  authorityApplication  AuthorityApplication  @relation(fields: [authorityId, applicationId], references: [authorityId, applicationId], onDelete: Restrict, onUpdate: Restrict)
  deployment            AuthorityDeployment?
  pendingForApplication AuthorityApplication? @relation("PendingAuthorityIntent")
  auditEvents           AuthorityAuditEvent[]

  @@unique([issuerId, idempotencyKey])
  @@index([authorityId, applicationId, status])
  @@index([authorityId, status])
}

model AuthorityDeployment {
  generationId  String    @id @default(uuid())
  authorityId   String
  applicationId String
  intentId      String    @unique
  status        String
  reasonCode    String?
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  authorizedAt  DateTime?
  invalidatedAt DateTime?
  updatedAt     DateTime  @updatedAt

  authorityApplication AuthorityApplication  @relation(fields: [authorityId, applicationId], references: [authorityId, applicationId], onDelete: Restrict, onUpdate: Restrict)
  intent               AuthorityIntent       @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services             AuthorityService[]
  activeForApplication AuthorityApplication? @relation("ActiveAuthorityDeployment")
  auditEvents          AuthorityAuditEvent[]

  @@index([authorityId, applicationId, status])
  @@index([status, updatedAt])
}

model AuthorityService {
  serviceIdentity        String   @id @default(uuid())
  deploymentId           String
  sourceServiceReference String
  serviceName            String
  createdAt              DateTime @default(now())

  deployment  AuthorityDeployment   @relation(fields: [deploymentId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  auditEvents AuthorityAuditEvent[]

  @@unique([deploymentId, serviceIdentity])
  @@unique([deploymentId, sourceServiceReference])
  @@index([deploymentId])
}

model AuthorityAuditEvent {
  id              String   @id @default(uuid())
  authorityId     String
  sequence        Int
  issuerId        String
  applicationId   String?
  deploymentId    String?
  intentId        String?
  serviceIdentity String?
  eventType       String
  status          String?
  reasonCode      String?
  timestamp       DateTime

  authority  Authority            @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployment AuthorityDeployment? @relation(fields: [deploymentId], references: [generationId], onDelete: Restrict, onUpdate: Restrict)
  intent     AuthorityIntent?     @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  service    AuthorityService?    @relation(fields: [serviceIdentity], references: [serviceIdentity], onDelete: Restrict, onUpdate: Restrict)

  @@unique([authorityId, sequence])
  @@index([intentId])
  @@index([deploymentId])
  @@index([serviceIdentity])
  @@index([timestamp])
}

// ==============================================================================
// 1. BACKUP CONFIGURATION (DESIRED STATE)
// ==============================================================================

enum BackupEnabledStatus {
  ENABLED
  DISABLED
}

enum BackupSourceType {
  DATABASE
  PERSISTENT_FILES
}

enum DatabaseEngineType {
  MARIADB
  MYSQL
  POSTGRESQL
  SQLITE
}

enum DestinationType {
  LOCAL_FILESYSTEM
  SYNOLOGY_NAS
  SMB_SHARE
  S3_COMPATIBLE
}

model BackupConfig {
  id                String              @id @default(uuid())
  applicationId     String              @unique
  status            BackupEnabledStatus @default(ENABLED)
  retentionVersions Int                 @default(3)
  scheduleCron      String?
  destinationId     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destination BackupDestination    @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sources     BackupSourceConfig[]
  jobs        BackupJob[]

  @@index([status])
}

model BackupSourceConfig {
  id                 String              @id @default(uuid())
  backupConfigId     String
  sourceType         BackupSourceType
  name               String
  dbEngine           DatabaseEngineType?
  dbTarget           String?
  dbHost             String?
  dbPort             Int?
  dbUser             String?
  dbSecretRef        String?
  fileHostPath       String?
  fileExclusions     String?
  fileFollowSymlinks Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  backupConfig BackupConfig @relation(fields: [backupConfigId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([backupConfigId, name])
  @@index([backupConfigId, sourceType])
}

model BackupDestination {
  id                 String          @id @default(uuid())
  name               String          @unique
  type               DestinationType @default(LOCAL_FILESYSTEM)
  basePath           String
  isActive           Boolean         @default(true)
  configJsonRedacted String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  backupConfigs BackupConfig[]
  artifacts     BackupArtifact[]
}

// ==============================================================================
// 2. BACKUP JOB & EXECUTION (TRANSIENT / RUNTIME STATE)
// ==============================================================================

enum BackupJobStatus {
  QUEUED
  INITIALIZING
  CAPTURING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum BackupTriggerType {
  MANUAL
  SCHEDULED
}

model BackupJob {
  id                String            @id @default(uuid())
  applicationId     String
  backupConfigId    String
  triggerType       BackupTriggerType @default(MANUAL)
  actorId           String?
  status            BackupJobStatus   @default(QUEUED)
  failureReasonCode String?
  failureDetail     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  backupConfig BackupConfig          @relation(fields: [backupConfigId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceTasks  BackupJobSourceTask[]
  artifact     BackupArtifact?

  @@index([applicationId, createdAt])
  @@index([status, startedAt])
}

model BackupJobSourceTask {
  id                String           @id @default(uuid())
  jobId             String
  sourceName        String
  sourceType        BackupSourceType
  status            BackupJobStatus  @default(QUEUED)
  bytesCaptured     BigInt           @default(0)
  sha256Digest      String?
  failureReasonCode String?
  startedAt         DateTime?
  completedAt       DateTime?

  job BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([jobId, sourceName])
  @@index([jobId, status])
}

// ==============================================================================
// 3. IMMUTABLE HISTORICAL RECORDS & ARTIFACTS
// ==============================================================================

enum VerificationStatus {
  PENDING
  VERIFIED
  VERIFICATION_FAILED
}

model BackupArtifact {
  id                 String             @id @default(uuid())
  jobId              String             @unique
  applicationId      String
  destinationId      String
  bundleFileName     String
  bundleSizeBytes    BigInt
  uncompressedBytes  BigInt
  sha256Digest       String
  manifestJson       String
  formatVersion      Int                @default(1)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  isRetained         Boolean            @default(true)
  prunedAt           DateTime?
  createdAt          DateTime           @default(now())

  job           BackupJob                  @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destination   BackupDestination          @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verifications BackupVerificationRecord[]

  @@index([applicationId, isRetained, createdAt])
  @@index([verificationStatus])
}

model BackupVerificationRecord {
  id                String             @id @default(uuid())
  artifactId        String
  status            VerificationStatus
  checksRunJson     String
  failureReasonCode String?
  performedAt       DateTime           @default(now())

  artifact BackupArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([artifactId, performedAt])
}
