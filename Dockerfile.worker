FROM node:22-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/application-registry-contracts/package.json packages/application-registry-contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/zimaos-adapter/package.json packages/zimaos-adapter/package.json
COPY prisma/schema.prisma prisma/schema.prisma
RUN npm ci
COPY apps/worker apps/worker
COPY packages/core packages/core
COPY packages/zimaos-adapter packages/zimaos-adapter
RUN npx prisma generate
RUN npm run build --workspace=@zima-control-center/core \
    && npm run build --workspace=@zima-control-center/zimaos-adapter \
    && npm run build --workspace=@zima-control-center/worker
RUN npm prune --omit=dev --omit=optional

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/package.json ./package.json
COPY --from=build --chown=node:node /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=node:node /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=node:node /workspace/packages/core/package.json ./packages/core/package.json
COPY --from=build --chown=node:node /workspace/packages/core/dist ./packages/core/dist
COPY --from=build --chown=node:node /workspace/packages/zimaos-adapter/package.json ./packages/zimaos-adapter/package.json
COPY --from=build --chown=node:node /workspace/packages/zimaos-adapter/dist ./packages/zimaos-adapter/dist
USER node
CMD ["node", "apps/worker/dist/start.js"]
