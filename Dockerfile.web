FROM node:22-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/trust-provisioner/package.json apps/trust-provisioner/package.json
COPY apps/runtime-authority/package.json apps/runtime-authority/package.json
COPY apps/runtime-issuer/package.json apps/runtime-issuer/package.json
COPY packages/application-registry-contracts/package.json packages/application-registry-contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/runtime-trust-contracts/package.json packages/runtime-trust-contracts/package.json
COPY packages/runtime-trust-authority/package.json packages/runtime-trust-authority/package.json
COPY packages/runtime-trust-issuer/package.json packages/runtime-trust-issuer/package.json
COPY packages/runtime-trust-linux-peer/package.json packages/runtime-trust-linux-peer/package.json
COPY packages/trust-persistence/package.json packages/trust-persistence/package.json
COPY packages/trust-prisma-client/package.json packages/trust-prisma-client/package.json
COPY packages/trust-provisioning/package.json packages/trust-provisioning/package.json
COPY packages/docker-adapter/package.json packages/docker-adapter/package.json
COPY packages/zimaos-adapter/package.json packages/zimaos-adapter/package.json
COPY prisma/schema.prisma prisma/schema.prisma
RUN npm ci
COPY apps/web apps/web
COPY packages/application-registry-contracts packages/application-registry-contracts
RUN npm run build --workspace=@zima-control-center/application-registry-contracts \
    && npm run build --workspace=@zima-control-center/web

FROM nginx:1.29-alpine AS runtime
COPY deployment/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
